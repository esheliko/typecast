# TMDB "API Read Access Token" (themoviedb.org/settings/api). Server-side only, never exposed to the browser.
TMDB_TOKEN=
# Optional: language for titles, overviews and provider names (default en-US)
TMDB_LANGUAGE=en-US

# Supabase project settings (Project Settings, then API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret (Project Settings, then API, service_role). Needed for user management on the Setup page. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The one account allowed to manage users. If unset, a built-in owner email is used and a warning is logged.
ADMIN_EMAIL=

# Optional for the Glimpse panel: serper.dev API key (real Google Images results, cached 30 days). A second key in SERPER_API_KEY_2 is used when the first is out of credits.
# Without a key (or when both are out) the panel uses TMDB and Wikimedia Commons, which are free and uncapped.
SERPER_API_KEY=
SERPER_API_KEY_2=
# Optional for the Glimpse panel: OpenWeb Ninja key (realtime image search, cached 30 days). Used after Serper when Serper is unset or out of credits, and before the free TMDB/Commons sources.
OPENWEBNINJA_API_KEY=

