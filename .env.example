# TMDB "API Read Access Token" (themoviedb.org/settings/api). Server-side only, never exposed to the browser.
TMDB_TOKEN=
# Optional: language for titles, overviews and provider names (default en-US)
TMDB_LANGUAGE=en-US

# Supabase project settings (Project Settings, then API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret (Project Settings, then API, service_role). Needed for user management on the Setup page. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The one account allowed to manage users. If unset, a built-in owner email is used and a warning is logged.
ADMIN_EMAIL=

# Optional: inline Google image results in the "Glimpse" (eye) panel. Programmable Search Engine with image search on.
# Without these, the panel still works but only offers a "More in Google Images" link.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Preferred for the Glimpse panel: serper.dev API key (real Google Images results, results cached 30 days).
SERPER_API_KEY=

