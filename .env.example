# TMDB "API Read Access Token" (themoviedb.org/settings/api). Server-side only, never exposed to the browser.
TMDB_TOKEN=
# Optional: language for titles, overviews and provider names (default en-US)
TMDB_LANGUAGE=en-US

# Supabase project settings (Project Settings, then API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
